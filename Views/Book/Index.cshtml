@model IEnumerable<NetCoreMVCLab04.Models.Book>

@{
    ViewData["Title"] = "Danh sách sách";
}

<h2 class="my-3">Danh Sách Sách</h2>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-3 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="@item.Image" class="card-img-top p-2" alt="@item.Title" style="height: 280px; object-fit: contain;">

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@item.Title</h5>
                    <p class="card-text text-muted mb-1">Mã sách: @item.Id</p>
                    <p class="card-text text-danger fw-bold fs-5 mt-auto">
                        @item.Price.ToString("#,##0") VNĐ
                    </p>
                </div>
            </div>
        </div>
    }
</div>