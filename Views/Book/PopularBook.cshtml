@model IEnumerable<NetCoreMVCLab04.Models.Book>

@foreach (var item in Model)
{
    <div class="col-xs-3 col-sm-3 col-md-3 col-lg-3">
        <div class="thumbnail">
            <img src="@item.Image" alt="@item.Title" style="width: 100%; height: 200px; object-fit: contain;" />
            <div class="caption">
                <h3>@item.Title</h3>
                <p>Price: @item.Price.ToString("#,##0") VNĐ</p>
            </div>
        </div>
    </div>
}