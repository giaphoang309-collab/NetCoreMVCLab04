@{
    ViewData["Title"] = "Trang chủ - Giao diện sản phẩm";
}

<div class="row">
    <div class="col-md-3">
        <partial name="_CategoryPartial" />
    </div>

    <div class="col-md-9">
        <div class="panel panel-primary" style="border: 1px solid #337ab7;">
            <div class="panel-heading" style="background-color: #337ab7; color: white; padding: 10px; font-weight: bold;">
                Sản phẩm mới nhất
            </div>
            <div class="panel-body" style="padding: 15px;">
                <div class="row">
                    @for (int i = 1; i <= 3; i++)
                    {
                        <div class="col-md-4 text-center">
                            <div class="thumbnail" style="border: 1px solid #ddd; padding: 10px; border-radius: 4px;">
                                <img src="~/images/noi-com.jpg" alt="Sản phẩm" style="height:150px; object-fit:contain;" />
                                <div class="caption">
                                    <h5 style="font-size: 14px; font-weight: bold; margin-top: 10px;">Nồi cơm điện cao tần Nagakawa NAG0102</h5>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @await Component.InvokeAsync("HotProduct")
    </div>
</div>

<div class="well" style="background-color: #222; color: white; padding: 20px; margin-top: 30px; border-radius: 4px;">
    <div class="row">
        <div class="col-md-6">
            <h4 style="color: #fff; font-weight: bold;">GIỚI THIỆU</h4>
            <p style="color: #ccc;">Website cung cấp các sản phẩm gia dụng chất lượng cao, cam kết chính hãng và bảo hành đầy đủ.</p>
        </div>
        <div class="col-md-6">
            <h4 style="color: #fff; font-weight: bold;">LIÊN HỆ</h4>
            <p style="color: #ccc;">Email: support@domain.com | Hotline: 1900 xxxx</p>
        </div>
    </div>
</div>